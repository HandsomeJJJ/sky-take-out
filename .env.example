# 复制成 .env 后填写；.env 已被 .gitignore 忽略，不要提交
# 生成长随机密钥： openssl rand -base64 48 | tr -d '\n='

# —— 必填：两个 JWT 签名密钥，长度至少 32 字节，缺失时应用直接启动失败 ——
JWT_ADMIN_SECRET_KEY=
JWT_USER_SECRET_KEY=

# —— 基础设施口令（compose 会同时用于容器与容器内 healthcheck）——
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=

# —— 集群部署时每个实例必须不同，否则同一毫秒会生成相同订单号 ——
SNOWFLAKE_WORKER_ID=1

# —— 打包费规则（服务端计算，客户端不再传金额）——
PACK_FEE_PER_ITEM=1.00
PACK_FEE_MAX=20.00
MAX_NUMBER_PER_ITEM=99

# —— 派送超时自动确认收货的阈值（分钟），基准是开始派送时间 ——
AUTO_COMPLETE_AFTER_MINUTES=120

# —— 图片回收：不再被引用后保留天数与单次回收数量 ——
MEDIA_RETENTION_DAYS=180
MEDIA_PURGE_BATCH_SIZE=100

# —— 阿里云 OSS ——
ALIOSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIOSS_ACCESS_KEY_ID=
ALIOSS_ACCESS_KEY_SECRET=
ALIOSS_BUCKET_NAME=

# —— 微信小程序 / 商户平台（务必在商户平台重置过的新密钥）——
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MCHID=
WECHAT_MCH_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_API_V3_KEY=
WECHAT_PAY_CERT_PATH=
WECHAT_NOTIFY_URL=https://your-domain/notify/paySuccess
WECHAT_REFUND_NOTIFY_URL=https://your-domain/notify/refundSuccess
